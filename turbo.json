{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "ARCJET_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_DELIVERY",
        "DOKU_ENV",
        "DOKU_CLIENT_ID",
        "DOKU_SECRET_KEY",
        "APP_ENCRYPTION_KEY"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "ARCJET_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_DELIVERY",
        "DOKU_ENV",
        "DOKU_CLIENT_ID",
        "DOKU_SECRET_KEY",
        "APP_ENCRYPTION_KEY",
        "VERCEL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": {}
  }
}
