# Names only. Copy to apps/web/.env.local and fill in. Never commit values.
# Production requirements: docs/STAGING.md.

NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for the publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ARCJET_KEY=

RESEND_API_KEY=
EMAIL_FROM=
# log (local) or resend (required in production)
EMAIL_DELIVERY=

# sandbox until M5 approval
DOKU_ENV=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# 32 bytes: 64 hex characters or base64
APP_ENCRYPTION_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
