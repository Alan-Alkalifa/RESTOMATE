{
  "name": "restomate",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write apps packages package.json turbo.json pnpm-workspace.yaml \"!**/.next/**\" \"!**/.turbo/**\"",
    "format:check": "prettier --check apps packages package.json turbo.json pnpm-workspace.yaml \"!**/.next/**\" \"!**/.turbo/**\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node packages/db/scripts/gen-types.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "supabase": "^2.0.0",
    "turbo": "^2.5.0"
  }
}
